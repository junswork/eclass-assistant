# ============================================================
# e-Class 자동 출석 & AI 심화 강의노트 생성기 설정
# ============================================================

# [1] Google Gemini API 설정 (필수: 강의노트 생성용)
# Google AI Studio에서 무료로 발급받으실 수 있습니다.
# 발급 링크: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_NOTE_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# [2] ntfy 스마트폰 푸시 알림 설정 (선택 사항)
# 스마트폰에 'ntfy' 앱을 설치하고 아래 설정한 토픽명을 구독하면,
# 출석 완료 및 강의노트 생성 완료 알림을 실시간으로 수신할 수 있습니다.
# 다른 사람과 겹치지 않는 본인만의 고유한 영문/숫자 토픽명을 입력하세요.
# 예: eclass_myname_7890
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# [3] 브라우저 동작 모드
# false: 브라우저 창이 화면에 뜨면서 출석 진행을 직접 볼 수 있음 (권장)
# true: 화면 없이 백그라운드에서 조용히 실행
HEADLESS=false
